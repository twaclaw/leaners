          <mxGeometry x="920" y="660" width="360" height="38" as="geometry" />
        </mxCell>
        <mxCell id="ex_n" value="The middle column is what the theorems quantify over: whatever lands there, the right column can carry markup only from the fixed vocabulary." style="text;html=0;align=left;fontSize=10;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="708" width="1240" height="18" as="geometry" />
