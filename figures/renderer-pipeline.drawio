          <mxGeometry x="40" y="606" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="ex2b" value="Paragraph [Link &quot;javascript:alert(1)&quot; [Text &quot;x&quot;]]" style="rounded=1;arcSize=6;html=0;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#111111;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="606" width="430" height="38" as="geometry" />
        </mxCell>
        <mxCell id="ex2c" value="&lt;p&gt;&lt;a href=&quot;&quot;&gt;x&lt;/a&gt;&lt;/p&gt;   unsafe scheme, href emptied" style="rounded=1;arcSize=6;html=0;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#111111;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="606" width="360" height="38" as="geometry" />
        </mxCell>
        <mxCell id="ex3a" value="&lt;script&gt;alert(1)&lt;/script&gt;" style="rounded=1;arcSize=6;html=0;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#111111;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="ex3b" value="raw HTML events, dropped by adapt.rs: no Ast node exists for them" style="rounded=1;arcSize=6;html=0;fillColor=#fff1e0;strokeColor=#dfa76b;fontSize=10;fontColor=#111111;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1">
