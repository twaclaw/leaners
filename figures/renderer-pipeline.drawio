        <mxCell id="e5" value="HTML bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#666666;fontSize=10;fontColor=#666666;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_re" target="n_out">
